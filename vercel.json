{
  "version": 2,
  "builds": [
    {
      "src": "backend-part/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "img/**",
          "model/**",
          "frontend-part/**",
          "node_modules/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "backend-part/server.js" }
  ]
}