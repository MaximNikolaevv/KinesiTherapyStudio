{
  "version": 2,
  "builds": [
    {
      "src": "backend-part/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "model/**",
          "frontend-part/**",
          "node_modules/**"
        ]
      }
    },
    {
      "src": "img/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/img/(.*)", "dest": "/img/$1" },
    { "src": "/(.*)", "dest": "backend-part/server.js" }
  ]
}